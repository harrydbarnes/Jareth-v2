<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Jareth.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Jareth">

    <Grid>
        <!-- Three column layout -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Grid Grid.Column="0" x:Name="LeftSidebar"
              Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- App Title -->
            <StackPanel Grid.Row="0" Padding="16,24,16,8" Orientation="Horizontal" Spacing="8">
                <Ellipse Width="32" Height="32" Fill="{StaticResource JarethAccentBrush}"/>
                <TextBlock Text="Jareth" FontSize="22" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- New Recording Button -->
            <Button Grid.Row="1" Margin="16,8" HorizontalAlignment="Stretch"
                    x:Name="NewRecordingButton"
                    Click="NewRecordingButton_Click"
                    Background="{StaticResource JarethAccentBrush}"
                    CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE717;" FontSize="16"/>
                    <TextBlock Text="New Recording"/>
                </StackPanel>
            </Button>

            <!-- Folder List -->
            <ListView Grid.Row="2" x:Name="FolderListView"
                      ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedFolder, Mode=TwoWay}"
                      SelectionChanged="FolderListView_SelectionChanged"
                      Margin="8,0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="8" Height="8"
                                     Fill="{StaticResource JarethAccentBrush}"
                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- New Folder + Settings -->
            <StackPanel Grid.Row="3" Padding="8,8,8,16" Spacing="4">
                <Button HorizontalAlignment="Stretch" Click="NewFolderButton_Click"
                        Style="{ThemeResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8F4;" FontSize="14"/>
                        <TextBlock Text="New Folder" FontSize="13"/>
                    </StackPanel>
                </Button>
                <Button HorizontalAlignment="Stretch" Click="SettingsButton_Click"
                        Style="{ThemeResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE713;" FontSize="14"/>
                        <TextBlock Text="Settings" FontSize="13"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Separator -->
        <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right"
                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

        <!-- Middle Panel - Meeting List -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.SelectedFolderName, Mode=OneWay}"
                       FontSize="16" FontWeight="SemiBold"
                       Margin="16,16,16,8"/>

            <!-- Meeting list -->
            <ListView Grid.Row="1" x:Name="MeetingListView"
                      ItemsSource="{x:Bind ViewModel.Meetings, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedMeeting, Mode=TwoWay}"
                      SelectionChanged="MeetingListView_SelectionChanged"
                      Margin="8,0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8,8" Spacing="4">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding FormattedDate}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="·" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding FormattedDuration}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>

                <!-- Empty state -->
                <ListView.Footer>
                    <StackPanel Visibility="{x:Bind ViewModel.IsMeetingsEmpty, Mode=OneWay}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Padding="16,32" Spacing="8">
                        <FontIcon Glyph="&#xE77B;" FontSize="48"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="No meetings yet" HorizontalAlignment="Center"
                                   FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Hit 'New Recording' to get started." HorizontalAlignment="Center"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </ListView.Footer>
            </ListView>
        </Grid>

        <!-- Separator -->
        <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Right"
                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

        <!-- Right Panel - Content Frame -->
        <Frame Grid.Column="2" x:Name="ContentFrame"/>
    </Grid>
</Window>
