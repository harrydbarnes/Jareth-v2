<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Jareth.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jareth"
    xmlns:views="using:Jareth.Views"
    Title="Jareth">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Grid Grid.Column="0">
            <Grid.Background>
                <AcrylicBrush TintColor="#1E1E2E" TintOpacity="0.8" FallbackColor="#1E1E2E" />
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- App Logo / Name -->
            <TextBlock Grid.Row="0"
                       Text="Jareth"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{StaticResource JarethAccentBrush}"
                       Margin="20,20,20,10"
                       HorizontalAlignment="Left" />

            <!-- New Recording Button -->
            <Button Grid.Row="1"
                    Content="New Recording"
                    Click="OnNewRecordingClick"
                    Margin="16,8,16,8"
                    HorizontalAlignment="Stretch"
                    CornerRadius="{StaticResource JarethCornerRadius}"
                    Background="{StaticResource JarethAccentBrush}"
                    Foreground="Black"
                    FontWeight="SemiBold"
                    Padding="12,10" />

            <!-- New Folder Button -->
            <Button Grid.Row="2"
                    Content="+ New Folder"
                    Click="OnNewFolderClick"
                    Margin="16,4,16,8"
                    HorizontalAlignment="Stretch"
                    CornerRadius="{StaticResource JarethCornerRadius}"
                    Style="{StaticResource DefaultButtonStyle}"
                    Padding="12,8" />

            <!-- Folder List -->
            <ListView Grid.Row="3"
                      x:Name="FolderListView"
                      ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedFolder, Mode=TwoWay}"
                      SelectionChanged="OnFolderSelectionChanged"
                      Margin="8,0,8,0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,6" CornerRadius="8">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Rename" Click="OnRenameFolderClick" />
                                    <MenuFlyoutItem Text="Delete" Click="OnDeleteFolderClick" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MeetingCount}"
                                           Foreground="Gray"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Settings Button -->
            <Button Grid.Row="4"
                    Click="OnSettingsClick"
                    Margin="16,8,16,16"
                    HorizontalAlignment="Stretch"
                    CornerRadius="{StaticResource JarethCornerRadius}"
                    Padding="12,10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                    <TextBlock Text="Settings" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Middle Panel - Meeting List -->
        <Grid Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Meetings"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="16,16,16,8" />

            <!-- Meeting list -->
            <ListView Grid.Row="1"
                      x:Name="MeetingListView"
                      ItemsSource="{x:Bind ViewModel.Meetings, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedMeeting, Mode=TwoWay}"
                      Margin="8,0,8,0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,10" CornerRadius="8" Margin="0,2">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding FormattedDate}"
                                               FontSize="12"
                                               Foreground="Gray" />
                                    <TextBlock Text="{Binding FormattedDuration}"
                                               FontSize="12"
                                               Foreground="Gray" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty state -->
            <StackPanel Grid.Row="1"
                        x:Name="EmptyMeetingState"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}">
                <FontIcon Glyph="&#xE720;" FontSize="48" Foreground="Gray" />
                <TextBlock Text="No meetings yet"
                           FontSize="16"
                           Foreground="Gray"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Start a new recording to get going"
                           FontSize="12"
                           Foreground="Gray"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Right Panel -->
        <Grid Grid.Column="2" x:Name="RightPanel">
            <views:WelcomePage x:Name="WelcomePage" />
            <views:RecordingPage x:Name="RecordingPage" Visibility="Collapsed" />
            <views:SettingsPage x:Name="SettingsPage" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
