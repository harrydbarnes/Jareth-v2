<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Jareth.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="40" Spacing="24" MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/>

            <!-- Audio Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="Audio" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource JarethAccentBrush}"/>
                <Border CornerRadius="12" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Microphone" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.MicrophoneDevices, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedMicrophone, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" CornerRadius="8"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Default audio source" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.AudioSourceOptions}"
                                      SelectedItem="{x:Bind ViewModel.DefaultAudioSource, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" CornerRadius="8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- API Keys Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="API Keys" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource JarethAccentBrush}"/>
                <Border CornerRadius="12" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="OpenAI API Key" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <PasswordBox Password="{x:Bind ViewModel.OpenAiKey, Mode=TwoWay}"
                                         PlaceholderText="sk-..." CornerRadius="8"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Anthropic API Key" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <PasswordBox Password="{x:Bind ViewModel.AnthropicKey, Mode=TwoWay}"
                                         PlaceholderText="sk-ant-..." CornerRadius="8"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Google Gemini API Key" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <PasswordBox Password="{x:Bind ViewModel.GeminiKey, Mode=TwoWay}"
                                         PlaceholderText="AIza..." CornerRadius="8"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Local Model Endpoint" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBox Text="{x:Bind ViewModel.LocalModelEndpoint, Mode=TwoWay}"
                                     PlaceholderText="http://localhost:11434" CornerRadius="8"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Whisper API Key (optional)" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <PasswordBox Password="{x:Bind ViewModel.WhisperKey, Mode=TwoWay}"
                                         PlaceholderText="sk-..." CornerRadius="8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Appearance Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource JarethAccentBrush}"/>
                <Border CornerRadius="12" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Theme" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                                      SelectedItem="{x:Bind ViewModel.Theme, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" CornerRadius="8"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Font" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.FontOptions}"
                                      SelectedItem="{x:Bind ViewModel.Font, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" CornerRadius="8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Storage Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="Storage" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource JarethAccentBrush}"/>
                <Border CornerRadius="12" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.JarethFolderPath, Mode=OneWay}"
                                   FontSize="13" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button Content="Open folder" CornerRadius="8"
                                Command="{x:Bind ViewModel.OpenJarethFolderCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- About Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="About" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource JarethAccentBrush}"/>
                <Border CornerRadius="12" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Version" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.AppVersion}" FontSize="13"/>
                        </StackPanel>
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/harrydbarnes/Jareth-v2"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Save Button -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Save settings"
                        Background="{StaticResource JarethAccentBrush}"
                        CornerRadius="8"
                        Command="{x:Bind ViewModel.SaveCommand}"/>
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource JarethAccentBrush}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
