<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Jareth.Views.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="40" Spacing="24" MaxWidth="640" HorizontalAlignment="Center">

            <!-- Greeting -->
            <TextBlock x:Name="GreetingText"
                       Text="{x:Bind ViewModel.Greeting, Mode=OneWay}"
                       FontSize="28" FontWeight="Light"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       TextWrapping="Wrap"/>

            <!-- Meeting Title -->
            <StackPanel Spacing="6">
                <TextBlock Text="Meeting title" FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="TitleBox"
                         Text="{x:Bind ViewModel.MeetingTitle, Mode=TwoWay}"
                         PlaceholderText="What's this meeting about?"
                         CornerRadius="8" FontSize="15"/>
            </StackPanel>

            <!-- Audio Source -->
            <StackPanel Spacing="6">
                <TextBlock Text="Audio source" FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.AudioSourceOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedAudioSource, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" CornerRadius="8"/>
            </StackPanel>

            <!-- Microphone selector -->
            <StackPanel Spacing="6">
                <TextBlock Text="Microphone" FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.MicrophoneDevices, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedMicrophone, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" CornerRadius="8"/>
            </StackPanel>

            <!-- Record / Stop Button + Timer -->
            <Border CornerRadius="16" Padding="32,24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="20" HorizontalAlignment="Center">

                    <!-- Timer -->
                    <TextBlock Text="{x:Bind ViewModel.ElapsedTime, Mode=OneWay}"
                               FontSize="48" FontFamily="Consolas"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                    <!-- Peak Level Meter -->
                    <Grid Width="280" Height="8" CornerRadius="4">
                        <Rectangle Fill="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                   RadiusX="4" RadiusY="4"/>
                        <Rectangle x:Name="PeakBar"
                                   Width="{x:Bind GetPeakBarWidth(ViewModel.PeakLevel), Mode=OneWay}"
                                   Fill="{StaticResource JarethAccentBrush}"
                                   RadiusX="4" RadiusY="4"
                                   HorizontalAlignment="Left"/>
                    </Grid>

                    <!-- Start/Stop Button -->
                    <Button x:Name="RecordButton"
                            Width="80" Height="80"
                            CornerRadius="40"
                            Background="{StaticResource JarethAccentBrush}"
                            Click="RecordButton_Click"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="{x:Bind GetRecordIcon(ViewModel.IsRecording), Mode=OneWay}"
                                  FontSize="28"/>
                    </Button>

                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               HorizontalAlignment="Center" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
