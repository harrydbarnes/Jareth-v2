<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jareth.Views.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Greeting -->
        <TextBlock Grid.Row="0"
                   x:Name="GreetingText"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource JarethAccentBrush}"
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center" />

        <!-- Meeting Title -->
        <TextBox Grid.Row="1"
                 x:Name="MeetingTitleBox"
                 PlaceholderText="Meeting title"
                 Margin="0,0,0,16"
                 MaxWidth="400"
                 HorizontalAlignment="Center"
                 CornerRadius="{StaticResource JarethCornerRadius}" />

        <!-- Audio Source Selection -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,16">
            <RadioButton x:Name="MicOnlyRadio" Content="Mic Only" IsChecked="True" GroupName="AudioSource" />
            <RadioButton x:Name="SystemOnlyRadio" Content="System Audio" GroupName="AudioSource" />
            <RadioButton x:Name="BothRadio" Content="Both" GroupName="AudioSource" />
        </StackPanel>

        <!-- Microphone Selector -->
        <ComboBox Grid.Row="3"
                  x:Name="MicrophoneCombo"
                  PlaceholderText="Select Microphone"
                  Margin="0,0,0,24"
                  MaxWidth="400"
                  HorizontalAlignment="Center"
                  CornerRadius="{StaticResource JarethCornerRadius}" />

        <!-- Recording Area -->
        <StackPanel Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
            <!-- Timer -->
            <TextBlock x:Name="TimerText"
                       Text="00:00:00"
                       FontSize="48"
                       FontWeight="Light"
                       HorizontalAlignment="Center" />

            <!-- Audio Source Label -->
            <TextBlock x:Name="AudioSourceLabel"
                       Text="Mic Only"
                       FontSize="14"
                       Foreground="Gray"
                       HorizontalAlignment="Center" />

            <!-- Peak Level Meter -->
            <ProgressBar x:Name="LevelMeter"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Width="300"
                         Height="8"
                         CornerRadius="4"
                         Margin="0,8,0,0" />
        </StackPanel>

        <!-- Start/Stop Button -->
        <Button Grid.Row="5"
                x:Name="RecordButton"
                Click="OnRecordButtonClick"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                Padding="32,16"
                CornerRadius="{StaticResource JarethCornerRadius}"
                Background="{StaticResource JarethAccentBrush}"
                Foreground="Black"
                FontSize="18"
                FontWeight="SemiBold">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon x:Name="RecordIcon" Glyph="&#xE7C8;" FontSize="20" />
                <TextBlock x:Name="RecordButtonText" Text="Start Recording" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
