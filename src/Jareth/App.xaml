<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Jareth.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jareth">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Primary accent: Brat lime green -->
            <SolidColorBrush x:Key="JarethAccentBrush" Color="#8ACE00"/>
            <SolidColorBrush x:Key="JarethAccentDarkBrush" Color="#6BA000"/>
            <Color x:Key="JarethAccentColor">#8ACE00</Color>

            <!-- Card style -->
            <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>

            <!-- Sidebar item style -->
            <Style x:Key="SidebarItemStyle" TargetType="ListViewItem">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Padding" Value="12,8"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
