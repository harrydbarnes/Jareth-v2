<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Jareth</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <UseRidGraph>true</UseRidGraph>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <Version>1.0.0</Version>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <AppxBundle>Never</AppxBundle>
  </PropertyGroup>

  <!-- Unpackaged configuration: run directly from the build output folder, no MSIX/installer needed -->
  <PropertyGroup Condition="'$(Configuration)' == 'Unpackaged'">
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!--
    Windows App SDK 1.5 runs GenerateAppManifestFromAppx (in Microsoft.WindowsAppSDK.SelfContained.targets)
    regardless of EnableMsixTooling. It reads MsixContent\AppxManifest.xml from the intermediate output
    directory. For the Unpackaged config (EnableMsixTooling=false), this file is never staged by MSIX
    tooling, so the task fails with DirectoryNotFoundException.
    Fix: use BeforeTargets="GenerateAppManifestFromAppx" to hook directly before the failing task.
    RuntimeIdentifier condition removed as it may not be evaluated at target scheduling time.
  -->
  <Target Name="StageAppxManifestForUnpackagedPublish"
          BeforeTargets="GenerateAppManifestFromAppx"
          Condition="'$(WindowsPackageType)' == 'None'">
    <PropertyGroup>
      <_StageManifestIntermediateOutputPath Condition="$([System.IO.Path]::IsPathRooted('$(IntermediateOutputPath)'))">$(IntermediateOutputPath)</_StageManifestIntermediateOutputPath>
      <_StageManifestIntermediateOutputPath Condition="'$(_StageManifestIntermediateOutputPath)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)'))</_StageManifestIntermediateOutputPath>
      <_StageManifestMsixContentDir>$([System.IO.Path]::GetFullPath('$(_StageManifestIntermediateOutputPath)\MsixContent'))</_StageManifestMsixContentDir>
    </PropertyGroup>
    <ItemGroup>
      <_StageManifestRid Include="$(RuntimeIdentifier)" Condition="'$(RuntimeIdentifier)' != ''" />
      <_StageManifestRid Include="$([System.String]::Copy('$(RuntimeIdentifiers)').Split(';'))" Condition="'$(RuntimeIdentifiers)' != ''" />
      <_StageManifestRid Remove="@(_StageManifestRid)" Condition="'%(_StageManifestRid.Identity)' == ''" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_StageManifestRid)">
      <Output TaskParameter="Filtered" ItemName="_StageManifestRidUnique" />
    </RemoveDuplicates>
    <ItemGroup>
      <_StageManifestRidMsixContentDir Include="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\%(_StageManifestRidUnique.Identity)\MsixContent'))" />
    </ItemGroup>
    <MakeDir Directories="$(_StageManifestMsixContentDir)" />
    <MakeDir Directories="@(_StageManifestRidMsixContentDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Package.appxmanifest"
          DestinationFiles="$(_StageManifestMsixContentDir)\AppxManifest.xml"
          OverwriteReadOnlyFiles="true" />
    <Copy Condition="'@(_StageManifestRidMsixContentDir)' != ''"
          SourceFiles="$(MSBuildProjectDirectory)/Package.appxmanifest"
          DestinationFiles="%(_StageManifestRidMsixContentDir.Identity)/AppxManifest.xml"
          OverwriteReadOnlyFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240627000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jareth.Core\Jareth.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" />
  </ItemGroup>

</Project>
